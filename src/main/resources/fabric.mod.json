{
  "schemaVersion": 1,
  "id": "sbcompanion",
  "version": "${version}",
  "name": "SkyBlock Companion",
  "description": "One mod for all of Hypixel SkyBlock: tooltips and prices, a warp menu, a minimap, 30+ trackers, Garden, Mining, Crimson Isle, Rift, Dungeon and Slayer helpers, a profile viewer and more. One look, one settings menu.\n\nPress K in game for everything, H to move the HUD.\n\nDiscord: discord.gg/QrqX3pgVW2\nReport issues: github.com/Skyblock-Companion/SBC/issues\nSponsor: github.com/sponsors/Skyblock-Companion",
  "authors": ["zMuzy"],
  "license": "GPL-3.0-only",
  "icon": "assets/sbcompanion/icon.png",
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/sbc-hypixel-skyblock-companion",
    "sources": "https://github.com/Skyblock-Companion/SBC",
    "issues": "https://github.com/Skyblock-Companion/SBC/issues",
    "discord": "https://discord.gg/QrqX3pgVW2"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/QrqX3pgVW2",
        "modmenu.github_sponsors": "https://github.com/sponsors/Skyblock-Companion",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/sbc-hypixel-skyblock-companion",
        "modmenu.modrinth": "https://modrinth.com/mod/skyblockcompanion"
      }
    }
  },
  "environment": "client",
  "entrypoints": { "client": ["dev.zmuzy.sbc.SbcMod"] },
  "mixins": ["sbcompanion.mixins.json"],
  "accessWidener": "sbcompanion.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "fabric-api": ">=0.165.2",
    "java": ">=25"
  },
  "suggests": { "hypixel-mod-api": "*" }
}
